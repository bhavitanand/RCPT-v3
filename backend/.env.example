# Copy to .env. Never commit .env.
PORT=5000

# Ethereum + EVM chains (Ethereum works on the free plan; Base/BNB/Optimism may need a paid Etherscan plan)
ETHERSCAN_API_KEY=

# Plain-English explanations and chat. Without a key RCPT uses its built-in explainer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=20000

# Optional: faster/higher-limit providers (public endpoints are used by default)
SOLANA_RPC_URL=
TRONGRID_API_KEY=
BTC_API_BASE=

# Ransomwhere crowdsourced ransomware address list (downloaded daily, cached). Set to "off" to disable.
RANSOMWHERE=on

# Comma-separated frontend origins allowed by CORS. Leave empty for local development only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional JSON file with extra address labels: { "labels": [ { "chain", "address", "name", "category", "source" } ] }
EXTRA_LABELS_FILE=
